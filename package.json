{
  "name": "zettel-capture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "npm run test:vault && npm run test:sync",
    "test:vault": "esbuild tests/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=error && node node_modules/.cache/verify.mjs",
    "test:sync": "esbuild tests/sync.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sync.mjs --log-level=error && node node_modules/.cache/sync.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-window": "^7.1.0"
  }
}
